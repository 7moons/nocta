{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local Nocta UI window controls. No arbitrary shell or filesystem access.",
  "windows": ["main"],
  "permissions": [
    "core:default", "core:window:allow-minimize", "core:window:allow-toggle-maximize",
    "core:window:allow-close", "core:window:allow-start-dragging", "core:window:allow-set-always-on-top"
  ]
}
