{
  "name": "nocta",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop manager for Roblox accounts: sessions, multi-instance launching and client upkeep.",
  "license": "GPL-3.0-only",
  "author": "7moons (https://7moons.dev)",
  "homepage": "https://7moons.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/7moons/nocta.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "runtime:stage-browser": "node scripts/stage-browser.mjs",
    "runtime:manifest": "node scripts/runtime-manifest.mjs --write",
    "runtime:verify": "node scripts/runtime-manifest.mjs",
    "release": "node scripts/release.mjs",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "test:core": "cargo test -p nocta-core",
    "contracts": "cargo run -p nocta-core --bin export-contracts && prettier --write src/generated/contracts.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.js src-tauri/*.json",
    "lint": "eslint . --max-warnings 0",
    "i18n:unused": "bun scripts/unused-messages.ts",
    "format:check": "prettier --check src scripts tests *.json *.ts *.js src-tauri/*.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7"
  }
}
